# =============================================================================
# Hotel Kalya — Environment Configuration Example
# =============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Sub-Project 2 & 3: Supabase & PostgreSQL (Bookings, CMS, Auth)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Sub-Project 2: Payload CMS Secret
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=your-random-payload-secret-key-32-chars-minimum

# -----------------------------------------------------------------------------
# Sub-Project 4: Payment Gateways (Kenyan Market)
# -----------------------------------------------------------------------------
# Paystack (Credit/Debit Cards & M-Pesa STK)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Safaricom Daraja API (Direct M-Pesa STK Push & C2B)
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_PASSKEY=your-daraja-passkey
DARAJA_SHORTCODE=174379
DARAJA_CALLBACK_URL=https://hotelkalya.co.ke/api/webhooks/daraja

# -----------------------------------------------------------------------------
# Transactional Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Hotel Kalya Reservations <reservations@hotelkalya.co.ke>

# -----------------------------------------------------------------------------
# Bot Protection (Cloudflare Turnstile)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxx
